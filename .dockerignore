# .dockerignore patterns are not recursive: use `**/` to match at any depth.

# VCS and tooling
.git
.gitignore
.github
.husky
.vscode
.idea
.cursor
.claude
**/.DS_Store

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/npm-debug.log*
**/*.log
**/.next
**/.swc
**/.turbo
**/*.tsbuildinfo
next-env.d.ts

# Secrets
.env
.env.*

# Docs and AI instructions (not needed at runtime)
**/*.md
docs

# Tests and reports
e2e
playwright.config.ts
coverage
playwright-report
test-results
.lighthouseci

# Infrastructure and dev-only scripts
infra
scripts

# Container definitions
docker-compose.yaml
Dockerfile
