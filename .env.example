# Copy to .env and fill in the values. Never commit .env.
# Names only: allowed values and defaults are in the README, "Environment variables".

# Runtime
APP_ENV=
LOG_LEVEL=
PORT=

# Public (baked into the build)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Contact form
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_DRIVER=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=

# Basic-auth gate (development, preview and staging; optional when APP_ENV=local)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
UPSTREAM=
GATE_PORT=

# Origin guard (production only)
ORIGIN_VERIFY_SECRET=
ORIGIN_VERIFY_SECRET_PREVIOUS=
