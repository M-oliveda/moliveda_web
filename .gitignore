# Dependencies
node_modules/

# Next.js build output and caches
.next/
out/
build/
.swc/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Secrets: only the names-only template is committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
