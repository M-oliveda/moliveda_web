# Runs on the host (AGENTS.md "Host-only exceptions"). Never bypass it.
set -eu

# D35: the rulesets reject unsigned commits, so fail before doing any work.
if [ "$(git config --bool commit.gpgsign || true)" != "true" ]; then
  echo "pre-commit: commit signing is off. Run: git config commit.gpgsign true" >&2
  exit 1
fi

# Secret files, even after `git add -f`. Only .env.example may be committed.
blocked=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)(\.env(\..+)?|[^/]+\.(pem|key|p12|pfx)|(gha-creds-[^/]*|credentials[^/]*|[^/]*service-account[^/]*)\.json)$' |
  grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit secret files:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  exit 1
fi

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner

npx --no-install lint-staged
npm run typecheck
