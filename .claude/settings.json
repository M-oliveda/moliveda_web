{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-lint-suppressions.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.preview)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.preview)",
      "Edit(./.env.staging)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(git -c commit.gpgsign=false:*)",
      "Bash(HUSKY=0:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api:*)",
      "Bash(gcloud:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Edit(./.claude/settings.json)",
      "Edit(./LICENSE)",
      "Edit(./LICENSES/**)",
      "Edit(./REUSE.toml)"
    ],
    "allow": [
      "Bash(docker compose exec web npm run:*)",
      "Bash(docker compose run --rm web npm run:*)",
      "Bash(docker compose --profile e2e run --rm e2e:*)",
      "Bash(scripts/test-gate.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git show:*)"
    ]
  }
}
