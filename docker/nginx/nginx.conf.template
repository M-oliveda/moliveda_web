# Basic-auth gate in front of the Next.js app on development, preview and staging
# (MASTERPLAN §8.1). Production runs without it.
#
# Rendered at container start by the official image entrypoint with envsubst. The Dockerfile sets
# NGINX_ENVSUBST_FILTER so only ${UPSTREAM} is substituted here (the filter also allows
# BASIC_AUTH_HTPASSWD_FILE, which only the entrypoint reads now) and NGINX runtime variables such
# as $host stay untouched. This file is included in the `http` block.
# The auth directives for `location /` live in /etc/nginx/auth/gate-auth.conf, written at start by
# entrypoint.sh (the official entrypoint runs it in a subprocess, so it cannot export variables).

# Cloud Run terminates TLS before the container, so $scheme is always "http". Keep the protocol the
# client used when the header is present, and fall back to $scheme locally.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Rate-limit key: the rightmost X-Forwarded-For entry, which is appended by Google's front end.
# Entries to its left come from the client and can be spoofed. Confirm the format on the first
# gated deploy (MASTERPLAN §13); locally, without the header, the peer address is used.
map $http_x_forwarded_for $client_ip {
    "~(?<last>[^,\s]+)\s*$" $last;
    default $remote_addr;
}

# Slows down password guessing. `global` caps the whole instance whatever the key resolves to.
limit_req_zone $client_ip zone=per_client:1m rate=10r/s;
limit_req_zone $server_name zone=global:64k rate=50r/s;

# One JSON line per request in Cloud Logging's `httpRequest` shape. No credentials, cookies or
# basic-auth user names are logged.
log_format gate_json escape=json
    '{"severity":"INFO","component":"gate","message":"$request_method $uri $status",'
    '"correlationId":"$http_x_correlation_id",'
    '"httpRequest":{"requestMethod":"$request_method","requestUrl":"$uri","status":$status,'
    '"responseSize":"$body_bytes_sent","userAgent":"$http_user_agent","remoteIp":"$client_ip",'
    '"latency":"${request_time}s"}}';

upstream app {
    server ${UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    server_tokens off;
    access_log /dev/stdout gate_json;

    # The contact API accepts at most 16 KiB; anything far larger is rejected here with 413.
    client_max_body_size 32k;

    # Non-production environments must never be indexed, including their 401 and 429 responses.
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    # Credentials stop at the gate.
    proxy_set_header Authorization "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # Probes are exempt from auth so Cloud Run, Docker and the deploy smoke test can reach them.
    # They are not logged per request (MASTERPLAN §4.10).
    location = /health {
        auth_basic off;
        access_log off;
        proxy_pass http://app;
    }

    location = /ready {
        auth_basic off;
        access_log off;
        proxy_pass http://app;
    }

    location / {
        limit_req zone=per_client burst=20 nodelay;
        limit_req zone=global burst=100 nodelay;
        limit_req_status 429;

        # auth_basic logs the submitted user name at `error` level on every failed login (and an
        # unknown "user name" may be a mistyped password). Keep only crit and above here; the
        # access log still records 401, 429 and 5xx statuses.
        error_log /dev/stderr crit;

        # Written by the entrypoint: basic auth with the htpasswd file, or `auth_basic off;` when
        # the gate starts without credentials (only allowed when APP_ENV=local).
        include /etc/nginx/auth/gate-auth.conf;
        proxy_pass http://app;
    }
}
