gha-creds-*.json

# Test and quality reports
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.lighthouseci/
reports/
.stryker-tmp/

# Logs
*.log
npm-debug.log*

# Editors: keep the shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Claude Code: settings.json is shared, local overrides are personal
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
